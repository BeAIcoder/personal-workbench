# 复制为 .env 后按需修改；不修改也可直接使用默认值运行

# 服务监听地址与端口
HOST=127.0.0.1
PORT=8000

# 数据库连接：默认使用 SQLite（无需安装任何数据库服务）
# DATABASE_URL=sqlite:///D:/资产库/01-财税自动化/personal-workbench/backend/data/workbench.db

# 首次启动且数据库为空时是否写入示例数据：1 开启 / 0 关闭
SEED_ON_STARTUP=1

# 跨域允许来源（逗号分隔；开发模式下前端 Vite 跑在 5173 端口）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- AI 助手（Agent 团队）----
# 统一走 OpenAI 兼容协议，填齐下面三项即自动激活（未填则助手显示"模型未配置"，主功能不受影响）。
# 可选渠道（任选其一）：
#   ModelScope 推理:  https://api-inference.modelscope.cn/v1   模型如 Qwen/Qwen3.5-122B-A10B
#   硅基流动:         https://api.siliconflow.cn/v1            模型如 deepseek-ai/DeepSeek-V3.2
#   DeepSeek:         https://api.deepseek.com/v1              模型如 deepseek-chat
#   火山方舟:         https://ark.cn-beijing.volces.com/api/v3 模型如 doubao-xxx（需控制台开通）
#   DashScope 兼容:   https://dashscope.aliyuncs.com/compatible-mode/v1  模型如 qwen-plus
#   本地 Ollama:      http://127.0.0.1:11434/v1               模型如 qwen2.5:7b
LLM_PROVIDER=custom
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
