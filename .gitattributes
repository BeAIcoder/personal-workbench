# 脱敏过滤器：文本文件提交时经 dev/git_sanitize_filter.py 处理（见 dev/SANITIZE.md）
*.md    filter=sanitize
*.py    filter=sanitize
*.js    filter=sanitize
*.mjs   filter=sanitize
*.vue   filter=sanitize
*.json  filter=sanitize
*.yml   filter=sanitize
*.yaml  filter=sanitize
*.txt   filter=sanitize
*.example filter=sanitize
*.vbs   filter=sanitize
*.bat   filter=sanitize
*.html  filter=sanitize
*.css   filter=sanitize
# 无扩展名的脚本类文件（如有新增请在此登记；二进制一律不要加）
*.sh    filter=sanitize
